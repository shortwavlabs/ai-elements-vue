{
  "extends": "@repo/tsconfig/nuxt.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@repo/*": ["../*"],
      "@/*": ["./*"]
    },
    "lib": ["ES2015", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["**/*.ts", "**/*.vue"],
  "exclude": ["node_modules"]
}
